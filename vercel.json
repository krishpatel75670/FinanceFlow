{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "app/main.py",
            "framework": "fastapi"
        }
    },
    "rewrites": [
        {
            "source": "/auth/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/transactions/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/docs",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/docs/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/openapi.json",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/health",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}